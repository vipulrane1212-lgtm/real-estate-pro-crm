<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Flashing High-Visibility Alarm Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/alarm_red"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="OVERDUE FOLLOW-UP ALARM"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_alarm_lead_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Client Follow-up"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_alarm_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="+91 98765 43210"
        android:textColor="@color/primary_gold"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_alarm_overdue_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Scheduled for: Today | Overdue by 15 mins"
        android:textColor="#cbd5e1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txt_alarm_remarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1e293b"
        android:padding="12dp"
        android:text="Notes: Discussion on 3 BHK Flat in Andheri West"
        android:textColor="#94a3b8"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btn_alarm_call_now"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:background="#10b981"
        android:text="Call Client Now"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_alarm_complete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@color/primary_navy"
        android:text="Mark Follow-up as Completed"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_alarm_snooze_5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Snooze 5m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_alarm_snooze_10"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="Snooze 10m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_alarm_dismiss"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Acknowledge"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
