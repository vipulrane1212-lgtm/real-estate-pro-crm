# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-only, bypasses RLS for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Database Connection (Optional for local PostgreSQL / Docker)
DATABASE_URL=

# Application Public Host URL
NEXT_PUBLIC_APP_URL=
